\@writefile{lot}{\contentsline {table}{\numberline {4.1}{\ignorespaces Characteristic timescales (in days) for $M_{\rm  ej}=0.01\,M_\odot $. $\tau _m$ is the one-zone diffusion timescale (Eq.~\ref {eq:kn_closure} with $\xi =1$), $\tau _1=(\sqrt  3/\pi )\tau _m$ the diffusion timescale of the fundamental mode (Sec.~\ref {sec:modes}), $t_{\rm  thin}$ the transparency time (Eq.~\ref {eq:kn_tthin}), $t_\gamma $ the $\gamma $-ray trapping time for $\kappa _\gamma =0.05\,\mathrm  {cm^2\,g^{-1}}$ (Eq.~\ref {eq:kn_tgamma}), and $t_{{\rm  ineff},p}$ the thermalization time of electrons ($E_0=0.5\,\mathrm  {MeV}$) and $\alpha $ particles ($E_0=5\,\mathrm  {MeV}$) from Eq.~\ref {eq:kn_tineff}. The last three are independent of $\kappa $.}}{44}{table.4.1}\protected@file@percent }
