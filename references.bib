@article{lindblom_determining_1992,
	title = {Determining the {Nuclear} {Equation} of {State} from {Neutron}-{Star} {Masses} and {Radii}},
	volume = {398},
	issn = {0004-637X},
	url = {https://ui.adsabs.harvard.edu/abs/1992ApJ...398..569L},
	doi = {10.1086/171882},
	abstract = {A method is developed for determining the nuclear equation of state directly from a knowledge of the masses and radii of neutron stars. This analysis assumes only that equilibrium neutron-star matter has the stress-energy tensor of an isotropic fluid with a barotropic equation of state, and that general relativity describes a neutron star's internal gravitational field. We present numerical examples which illustrate how well this method will determine the equation of state when the appropriate observational data become available.},
	urldate = {2026-10-06},
	journal = {The Astrophysical Journal},
	publisher = {IOP},
	author = {Lindblom, Lee},
	month = oct,
	year = {1992},
	note = {ADS Bibcode: 1992ApJ...398..569L},
	keywords = {Astrophysics, Barotropism, Computational Astrophysics, EQUATION OF STATE, Equations Of State, METHODS: NUMERICAL, Neutron Stars, Nuclear Astrophysics, Radii, RELATIVITY, STARS: INTERIORS, STARS: NEUTRON, Stellar Interiors, Stellar Mass, Stellar Physics},
	pages = {569},
	file = {Full Text PDF:/home/diefer/snap/zotero-snap/common/Zotero/storage/MJR3ET9E/Lindblom - 1992 - Determining the Nuclear Equation of State from Neutron-Star Masses and Radii.pdf:application/pdf},
}

